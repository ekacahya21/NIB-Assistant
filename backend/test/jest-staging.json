{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".staging-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@zorilla/puppeteer-extra-plugin-stealth|@zorilla/puppeteer-extra-plugin)/)"
  ],
  "moduleNameMapper": {
    "^@zorilla/puppeteer-extra-plugin$": "<rootDir>/../node_modules/@zorilla/puppeteer-extra-plugin/dist/index.js"
  }
}
